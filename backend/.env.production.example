APP_NAME="Vocab Quest"
APP_ENV=production
APP_KEY=                          # Generate: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-app.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=errorlog
LOG_LEVEL=warning

# ==============================================================================
# DATABASE — TiDB Cloud Starter (free, MySQL-compatible)
# Get from: https://tidbcloud.com → Your Cluster → Connect
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com   # Replace with your host
DB_PORT=4000
DB_DATABASE=vocab_quest
DB_USERNAME=                      # Your TiDB username
DB_PASSWORD=                      # Your TiDB password
DB_SSL_VERIFY=false               # TiDB Cloud uses SSL but no CA file needed

# ==============================================================================
# PERFORMANCE (No Redis needed — file cache is fast on Render)
# ==============================================================================
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

BROADCAST_CONNECTION=log

# ==============================================================================
# CLOUDINARY (Image & Audio Storage)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=vocab_audio

# ==============================================================================
# TTS — ElevenLabs
# ==============================================================================
TTS_PROVIDER=elevenlabs
TTS_LANGUAGE=en-US
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
